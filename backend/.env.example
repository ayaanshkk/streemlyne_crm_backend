# Example settings for the StreemLyne backend. Copy to backend/.env and fill in.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SCHEMA=streemLyne_mt_dev2
JWT_SECRET_KEY=change-me
SECRET_KEY=change-me

# ---- FAI module (merged into StreemLyne, served under /api/fai) ----
# Tenants that may use the FAI module, and where their users land after login
FAI_TENANT_IDS=3
TENANT_HOME_PATHS={"3": "/fai"}
# Optional: enables FAI's Telegram reminders
TELEGRAM_BOT_TOKEN=
# Supabase Storage for FAI's certificates and documents
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=client-files
# AI test grading
ANTHROPIC_API_KEY=

# FAI module: stage / lookup IDs (no defaults in code)
STAGE_TYPE_SALES=1
STAGE_TYPE_TRAINING=2
STAGE_ID_LEAD=1
STAGE_ID_CONVERTED=3
STAGE_ID_TRAINING_DEFAULT=5
STAGE_ID_AWAITING_SCHEDULING=11
STAGE_ID_PO_RECEIVED=12
STAGE_LABEL_ENQUIRY=Enquiry
MISC_KEY_SALES_STAGE=sales_stage
MISC_KEY_CONVERTED_AT=converted_at
ACTIVE_STATUS_ID=1
COMMERCIAL_CATEGORY_ID=1
CALENDAR_CONTACT_METHOD=1
CALENDAR_ENTRY_TYPE=Training
CALENDAR_ENTRY_STATUS=Scheduled
CALENDAR_ENTRY_SOURCE=training_session
PO_UPLOAD_KIND=document
PARTICIPANT_ID_PREFIX=FAI
MAX_BULK_BATCHES=20
